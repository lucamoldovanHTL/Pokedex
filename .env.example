# Kopieren nach .env und Werte anpassen:  cp .env.example .env

# Domain des Servers (für HTTPS-Zertifikat). Lokal: localhost
DOMAIN=pokedex.example.com

# Django
DJANGO_SECRET_KEY=bitte-durch-langen-zufallswert-ersetzen
DJANGO_ALLOWED_HOSTS=pokedex.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pokedex.example.com

# Datenbank (PostgreSQL im Container)
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=bitte-sicheres-passwort-setzen

# Admin-Konto wird beim ersten Start angelegt (optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=bitte-aendern

# 1 = Demo-Trainer "ash" und "misty" (Passwort demo1234) anlegen
LOAD_DEMO_DATA=0
